<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputType>Library</OutputType>
    <LangVersion>preview</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyTitle>BiomesCaverns</AssemblyTitle>
    <Product>BiomesCaverns</Product>
    <Copyright>Copyright © The Biomes Team 2024</Copyright>
    <AssemblyVersion>1.6.3.0</AssemblyVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BiomesCore">
      <HintPath>..\..\..\BiomesFramework\1.7\Assemblies\BiomesCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4979-alpha" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3">
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <Publicize Include="Assembly-CSharp:RimWorld.ActiveDropPod.contents" />
    <Publicize Include="Assembly-CSharp:RimWorld.ActiveDropPod.PodOpen" />
    <Publicize Include="Assembly-CSharp:RimWorld.CompLaunchable.FuelInLeastFueledFuelingPortSource" />
    <Publicize Include="Assembly-CSharp:RimWorld.Planet.TravelingTransportPods.Start" />
    <Publicize Include="Assembly-CSharp:RimWorld.Planet.TravelingTransportPods.End" />
    <Publicize Include="Assembly-CSharp:Verse.GenStep_ScatterGroup.map" />
    <Publicize Include="Assembly-CSharp:Verse.ThingOwner.GetAt" />
    <Publicize Include="Assembly-CSharp:RimWorld.WildPlantSpawner.calculatedWholeMapNumDesiredPlants" />
    <Publicize Include="Assembly-CSharp:RimWorld.WildPlantSpawner.calculatedWholeMapNumDesiredPlantsTmp" />
    <Publicize Include="Assembly-CSharp:RimWorld.WildPlantSpawner.CacheWholeMapNumDesiredPlants" />
    <Publicize Include="Assembly-CSharp:RimWorld.WildPlantSpawner.cycleIndex" />
    <Publicize Include="Assembly-CSharp:RimWorld.WildPlantSpawner.calculatedWholeMapNumNonZeroFertilityCells" />
    <Publicize Include="Assembly-CSharp:RimWorld.WildPlantSpawner.calculatedWholeMapNumNonZeroFertilityCellsTmp" />
    <Publicize Include="Assembly-CSharp:RimWorld.WildPlantSpawner.CanRegrowAt" />
  </ItemGroup>
</Project>